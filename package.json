{
  "name": "pylinkage-editor",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cd server && uv run pylinkage-editor-server",
    "build": "tsc && vite build",
    "build:wheel": "node scripts/build-server-wheel.mjs",
    "test:wasm": "node scripts/check-wasm-backend.mjs",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.0",
    "konva": "^10.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "zundo": "^2.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "playwright": "^1.57.0",
    "pyodide": "^314.0.7",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.3.5"
  }
